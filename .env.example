STORAGE_PATH=/tmp/aruna
# Fjall persistence mode for local storage and document-sync metadata state.
# buffer flushes to OS buffers for lower latency; sync_all fsyncs data and
# metadata before local Fjall persistence returns.
ARUNA_FJALL_PERSIST_MODE=buffer
# Metadata index storage under STORAGE_PATH. CRAQLE_SEARCH_STORAGE selects the
# search index backend: disk (default) or memory.
# CRAQLE_STORAGE_PATH=/tmp/aruna/craqle
CRAQLE_SEARCH_STORAGE=disk
# Document sync state under STORAGE_PATH.
# DOCUMENT_SYNC_STORAGE_PATH=/tmp/aruna/document-sync
BLOB_ROOT=/tmp/aruna/blobstore
# Document sync timeouts and intervals in seconds. Defaults: connect 30,
# per-sync I/O 30, resync every 5, backoff from 1 up to 600, full sweep every
# 86400 starting at 10800 (03:00 UTC).
# DOCUMENT_SYNC_CONNECT_TIMEOUT_SECS=30
# DOCUMENT_SYNC_IO_TIMEOUT_SECS=30
# DOCUMENT_SYNC_RESYNC_INTERVAL_SECS=5
# DOCUMENT_SYNC_RESYNC_INITIAL_BACKOFF_SECS=1
# DOCUMENT_SYNC_RESYNC_MAX_BACKOFF_SECS=600
# DOCUMENT_SYNC_FULL_SWEEP_INTERVAL_SECS=86400
# DOCUMENT_SYNC_FULL_SWEEP_TIME_OF_DAY_SECS=10800
# Backends file replacing the implicit single filesystem backend, as a TOML
# file holding one [backend.<name>] section per backend (type = "filesystem"
# or "s3", plus root, endpoint, region, bucket, class, quota_bytes, ...).
# BLOB_BACKENDS_PATH=/etc/aruna/backends.toml
# S3 credentials never live in that file: each backend named <name> reads
# BLOB_BACKEND_<NAME>_ACCESS_KEY_ID and BLOB_BACKEND_<NAME>_SECRET_ACCESS_KEY.
# The name is uppercased with every non-alphanumeric character mapped to `_`.
# BLOB_BACKEND_HOT_ACCESS_KEY_ID=...
# BLOB_BACKEND_HOT_SECRET_ACCESS_KEY=...
# Optional bucket prefix and the rollover bucket size. The multipart bucket
# holds unfinished multipart parts; an empty value restores the default.
BLOB_BUCKET_PREFIX=
BLOB_MULTIPART_BUCKET=uploaded-parts
BLOB_MAX_BUCKET_SIZE=100000
# Blob control-plane connect and I/O timeouts, and the no-progress transfer
# timeout, all in seconds (defaults 30, 30 and 1800).
# BLOB_CONTROL_PLANE_CONNECT_TIMEOUT_SECS=30
# BLOB_CONTROL_PLANE_IO_TIMEOUT_SECS=30
# BLOB_TRANSFER_IDLE_TIMEOUT_SECS=1800
SOCKET_ADDRESS=0.0.0.0:3000
# Dedicated operations listener serving /health, /ready (and /healthz, /readyz
# aliases) plus /metrics. Keep this port cluster-internal: it is unauthenticated
# by design. Defaults to 127.0.0.1:3002 (loopback) when unset.
OPS_SOCKET_ADDRESS=127.0.0.1:3002
# Total budget for the ordered graceful shutdown. Stay below the Kubernetes
# terminationGracePeriodSeconds (30s default). Defaults to 20 when unset.
# Values below 16 cannot fund the protected network, metadata, blob and storage
# tail; they are rejected and the 20 second default applies instead.
# ARUNA_SHUTDOWN_GRACE_SECS=20
P2P_SOCKET_ADDRESS=0.0.0.0:3001
P2P_ADDITIONAL_RELAY_URLS=
# Per-connection iroh stream caps. Unset leaves each direction uncapped.
# MAX_CONCURRENT_UNI_STREAMS=256
# MAX_CONCURRENT_BIDI_STREAMS=256
REALM_DESCRIPTION="Aruna Realm"
ONBOARDING_SECRET=
# Seconds a joiner waits for the seed's onboarding bootstrap reply (default 120).
# ONBOARDING_BOOTSTRAP_TIMEOUT_SECS=120
# Seconds for one onboarding document sync and the placement wait (default 60).
# ONBOARDING_DOCUMENT_SYNC_TIMEOUT_SECS=60

# Default metadata replication factor for newly created metadata. Values below
# 1 are coerced to 1.
METADATA_REPLICATION_FACTOR=3

S3_HOST=127.0.0.1:1337
S3_ADDRESS=0.0.0.0:1337
# Seconds an accepted S3 connection may stay silent before its first request.
# S3_INITIAL_REQUEST_TIMEOUT_SECS=10
# Seconds without body I/O progress before an S3 connection is cancelled.
# S3_CONNECTION_IDLE_TIMEOUT_SECS=20
# Total seconds one streamed S3 request may live.
# S3_STREAM_LIFETIME_TIMEOUT_SECS=1800

# OIDC providers, comma-separated. Each id <ID> reads its own block of
# OIDC_<ID>_ISSUER, OIDC_<ID>_AUDIENCE and OIDC_<ID>_DISCOVERY_URL values.
# The id is uppercased with every non-alphanumeric character mapped to `_`.
OIDC_PROVIDER_IDS=
# OIDC_MAIN_ISSUER=https://id.example.org/realms/aruna
# OIDC_MAIN_AUDIENCE=aruna-api
# OIDC_MAIN_DISCOVERY_URL=https://id.example.org/realms/aruna/.well-known/openid-configuration

# Request admission limits for REST and S3, per minute and burst (defaults
# 6000/1000 per IP, 3000/500 per principal, 1024 S3 connections, 512
# in-flight S3 requests).
# RATE_LIMIT_IP_PER_MINUTE=6000
# RATE_LIMIT_IP_BURST=1000
# RATE_LIMIT_PRINCIPAL_PER_MINUTE=3000
# RATE_LIMIT_PRINCIPAL_BURST=500
# S3_MAX_CONNECTIONS=1024
# S3_MAX_CONCURRENT_REQUESTS=512

# RO-Crate upload and storage limits in bytes, entries and milliseconds.
# Defaults in order below: 8 GiB direct upload, 100 GiB import source,
# 100 GiB expanded import, 100 GiB exported artifact, 100000 entries,
# 16 MiB metadata, 1024-byte keys, 1 day upload retention, 7 days artifact
# retention, 4 active jobs, 1 day holder TTL, 8 hours holder refresh.
# ROCRATE_DIRECT_UPLOAD_BYTES=8589934592
# ROCRATE_IMPORT_SOURCE_BYTES=107374182400
# ROCRATE_EXPANDED_IMPORT_BYTES=107374182400
# ROCRATE_EXPORT_ARTIFACT_BYTES=107374182400
# ROCRATE_MAX_ENTRIES=100000
# ROCRATE_METADATA_BYTES=16777216
# ROCRATE_KEY_BYTES=1024
# ROCRATE_UPLOAD_RETENTION_MS=86400000
# ROCRATE_JOB_RETENTION_MS=604800000
# ROCRATE_MAX_ACTIVE_JOBS=4
# ROCRATE_HOLDER_TTL_MS=86400000
# ROCRATE_HOLDER_REFRESH_MS=28800000

# Compute executor: none (default), docker, apptainer or kubernetes. Optional
# keys apply only to the selected executor and are ignored otherwise.
# ARUNA_COMPUTE_EXECUTOR=none
# ARUNA_COMPUTE_OPTIONAL=true
# ARUNA_COMPUTE_S3_URL=
# ARUNA_COMPUTE_MAX_CPU_CORES=
# ARUNA_COMPUTE_MAX_RAM_BYTES=
# ARUNA_COMPUTE_MAX_DISK_BYTES=
# ARUNA_COMPUTE_MAX_CONCURRENT=
# ARUNA_COMPUTE_STATE_ROOT=./compute-state
# ARUNA_COMPUTE_STOP_GRACE=10
# ARUNA_COMPUTE_KEEP_FAILED=false
# ARUNA_COMPUTE_LOCAL_ONLY=false
# ARUNA_COMPUTE_DOCKER_DISK_BYTES=
# ARUNA_COMPUTE_DOCKER_PULL_DEADLINE=300
# ARUNA_COMPUTE_DOCKER_SESSION_SUBNET=172.30.255.0/24
# ARUNA_COMPUTE_APPTAINER_CGROUP_ROOT=
# ARUNA_COMPUTE_APPTAINER_STATE_ROOT=./compute-state/apptainer
# ARUNA_COMPUTE_APPTAINER_SIF_CACHE=./compute-state/sif
# ARUNA_COMPUTE_APPTAINER_PULL_DEADLINE=300
# ARUNA_COMPUTE_K8S_NAMESPACE=default
# ARUNA_COMPUTE_K8S_STORAGE_CLASS=
# ARUNA_COMPUTE_K8S_HELPER_IMAGE=
# ARUNA_COMPUTE_K8S_PULL_DEADLINE=300
# ARUNA_COMPUTE_K8S_S3_CIDRS=
# ARUNA_COMPUTE_K8S_S3_PORT=443
# ARUNA_COMPUTE_K8S_S3_MOUNT_DRIVER=
# ARUNA_COMPUTE_K8S_SERVICE_ACCOUNT=aruna-workload
# ARUNA_COMPUTE_K8S_EXECUTION_LOCATION=
# ARUNA_COMPUTE_K8S_EXECUTION_LABELS=
# ARUNA_COMPUTE_K8S_NODE_SELECTOR=

# Public base URLs advertised in NodeInfo (http/https scheme required). Leave an
# endpoint empty when it is not publicly reachable; bind addresses and S3_HOST
# are never advertised as fallbacks. S3_HOST remains scheme-less because it is
# used for virtual-hosted bucket matching.
API_PUBLIC_URL=
S3_PUBLIC_URL=
# Streamable HTTP MCP interface on /mcp. Defaults to enabled.
MCP=enabled

# Comma-separated CIDR networks or bare IPs whose x-forwarded-* headers are
# honored when building client-facing URLs. Empty trusts no proxy.
TRUSTED_PROXIES=

# Placement metadata used only when creating or onboarding this node's realm
# placement-map entry. NodeInfo and affinity selectors both read labels from
# that entry; later restarts do not reapply these environment values.
# ARUNA_NODE_LABELS is comma-separated key=value pairs; the reserved keys
# aruna-engine.org/kind and aruna-engine.org/location are rejected, the latter
# because the node stamps it from ARUNA_NODE_LOCATION.
ARUNA_NODE_LOCATION=
ARUNA_NODE_WEIGHT=
ARUNA_NODE_LABELS=

# Comma-separated list of origins allowed to call the REST and S3 interfaces
# from a browser (e.g. http://localhost:5173 for the portal dev server).
# Empty = deny all cross-origin requests. A literal * allows every origin.
CORS_ALLOWED_ORIGINS=

# The REST API always additionally admits the two fixed origins of the
# first-party Aruna Desktop app (tauri://localhost and http://tauri.localhost),
# with or without a configured list above, so the app can talk to this realm.
# REST authenticates by bearer token and never by cookie, so the origin list is
# defense in depth, not the authorization boundary. Set DESKTOP_CORS=off (also
# false, 0, no) to drop the admission; the S3 interface never admits them.
DESKTOP_CORS=

# Portal artifact preparation. disabled means the API only reports portal
# status; artifact downloads and safely unpacks a verified tar.gz into PORTAL_DIR.
# If PORTAL_DIR already contains index.html, startup serves it without downloading.
# The release .sha256 sidecar is downloaded for verification; PORTAL_ARTIFACT_SHA256
# is optional and pins the expected sidecar checksum when set.
PORTAL_MODE=disabled
PORTAL_ARTIFACT_URL=
PORTAL_ARTIFACT_SHA256=
PORTAL_DIR=

# Bind address of the portal listener. The portal serves the SPA on its own
# origin, so this is required whenever PORTAL_MODE is not disabled, and
# API_PUBLIC_URL is then required too: the served portal config advertises it as
# the absolute API base and CORS_ALLOWED_ORIGINS must contain the portal origin.
PORTAL_SOCKET_ADDRESS=127.0.0.1:3003

# Portal responses carry a Content-Security-Policy whose connect-src allows the
# configured API origin, this node's advertised S3 endpoint and the realm's OIDC
# provider origins. Add comma-separated origins here when the portal must reach
# anything else from the browser, such as the S3 endpoints of other realm nodes.
PORTAL_CSP_EXTRA_ORIGINS=

# Maximum REST request body size in bytes (default 1 MiB). Oversized bodies
# are rejected with 413.
MAX_HTTP_BODY_SIZE=1048576

# Node-side assistant provider storage and proxy routes. Defaults to enabled.
ASSISTANT_PROXY=enabled

# Inbound metadata events stamped further than this many seconds in the
# future are rejected (conflict resolution is last-writer-wins on wall
# clock). Run NTP on every node. Default 300.
MAX_CLOCK_SKEW_SECS=

RUST_LOG=
# Log output format: text (default) or json for structured log ingestion.
LOG_FORMAT=text
OTEL_EXPORTER_OTLP_ENDPOINT=
