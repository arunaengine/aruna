# SHACL shape for the publisher that InvenioRDM instances other than Zenodo need to mint a DOI.
# Copyright (c) 2026 The Aruna Contributors
# SPDX-License-Identifier: MIT or Apache-2.0

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix pub: <https://w3id.org/aruna/profiles/repository/publisher#> .

pub:shape-Dataset a sh:NodeShape ;
  sh:property pub:shape-Dataset-publisher .

pub:shape-Dataset-publisher a sh:PropertyShape ;
  sh:path schema:publisher ;
  sh:name "Publisher" ;
  sh:description "The organization that publishes the record, as text or a named entity." ;
  sh:order 4 ;
  sh:minCount 1 ;
  sh:or (
    [ sh:datatype xsd:string ; sh:minLength 1 ]
    [ sh:path schema:name ; sh:minCount 1 ]
  ) ;
  sh:message "The dataset needs a publisher, as text or an entity with a name." .
