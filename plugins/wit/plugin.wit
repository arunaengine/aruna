package aruna:plugin@0.3.0;

/// Data shared by the handler export and the host interfaces.
interface types {
  /// One header or query pair.
  record field {
    name: string,
    value: string,
  }

  /// A verified webhook request; authentication headers are already removed.
  record webhook-request {
    method: string,
    query: string,
    headers: list<field>,
    body: list<u8>,
  }

  record webhook-delivery {
    delivery-id: option<string>,
    request: webhook-request,
  }

  /// A committed change in the install's group; kind is the trigger name.
  record watch-event {
    kind: string,
    path: string,
    %resource: string,
    revision: string,
  }

  /// Why the host started the handler: manual input is JSON text, a timer gives its tick time.
  variant trigger {
    manual(string),
    webhook(webhook-delivery),
    event(watch-event),
    timer(u64),
  }

  /// Input of every handler call; settings are the install's JSON settings.
  record invocation {
    run: string,
    install: string,
    group: string,
    settings: string,
    trigger: trigger,
  }

  enum failure-kind {
    permanent,
    retryable,
    invalid-input,
  }

  record failure {
    kind: failure-kind,
    message: string,
  }

  enum error-kind {
    not-granted,
    denied,
    invalid,
    limit,
    conflict,
    unknown-outcome,
    unavailable,
    not-found,
  }

  record host-error {
    kind: error-kind,
    message: string,
  }
}

/// Reads dataset metadata of the group (`metadata.read`).
interface metadata-read {
  use types.{host-error};

  record document {
    %resource: string,
    revision: string,
    json: string,
  }

  record listing {
    resources: list<string>,
    cursor: option<string>,
  }

  record file-page {
    files: list<string>,
    cursor: option<string>,
  }

  get: func(%resource: string) -> result<document, host-error>;
  %list: func(cursor: option<string>) -> result<listing, host-error>;
  /// One page of the dataset's root-linked `File` entities as JSON objects, in `@id` order.
  files: func(%resource: string, cursor: option<string>) -> result<file-page, host-error>;
  /// The dataset entity without its file links.
  summary: func(%resource: string) -> result<document, host-error>;
}

/// Changes dataset metadata if its revision is still `expected` (`metadata.write`).
interface metadata-write {
  use types.{host-error};

  patch: func(
    %resource: string,
    patch: string,
    expected: string,
  ) -> result<string, host-error>;

  /// Adds or replaces one `File` entity by `@id`; the properties it omits go.
  put-file: func(
    %resource: string,
    file: string,
    expected: string,
  ) -> result<string, host-error>;

  /// Removes one root-linked `File` entity by `@id` and the root's link to it.
  remove-file: func(
    %resource: string,
    id: string,
    expected: string,
  ) -> result<string, host-error>;
}

/// Creates datasets of the group (`metadata.create`).
interface metadata-create {
  use types.{host-error};

  record created {
    %resource: string,
    revision: string,
  }

  /// Creates a dataset at `path` below the group's metadata root from one dataset entity; the
  /// same `path` of one install always names the same document.
  create: func(path: string, dataset: string) -> result<created, host-error>;
}

/// Reads object information, listings and the bytes of small objects of the group (`objects.read`).
interface objects-read {
  use types.{host-error};

  record object-info {
    path: string,
    size: u64,
    version: string,
    /// A job with a secret wrote this version: a plugin cannot read, copy or upload it.
    marked: bool,
  }

  record object-page {
    objects: list<object-info>,
    cursor: option<string>,
  }

  /// The information of one version, the current one unless `version` is given.
  info: func(path: string, version: option<string>) -> result<object-info, host-error>;
  /// The bytes of one version, the current one unless `version` is given, within the call's
  /// byte bound; a marked version is refused.
  read: func(path: string, version: option<string>) -> result<list<u8>, host-error>;
  %list: func(prefix: string, cursor: option<string>) -> result<object-page, host-error>;
}

/// Sends requests to the services the manifest declares; the host adds their secrets.
interface services {
  use types.{field, host-error};

  enum method {
    get,
    head,
    post,
    put,
    patch,
    delete,
  }

  /// `path` is relative to the service's address.
  record request {
    service: string,
    method: method,
    path: string,
    query: list<field>,
    headers: list<field>,
    body: list<u8>,
  }

  /// The status, and the headers and body the code may read of the answer.
  record response {
    status: u16,
    headers: list<field>,
    body: list<u8>,
  }

  send: func(request: request) -> result<response, host-error>;
}

/// Small private values of the install, changed by compare and swap.
interface state {
  use types.{host-error};

  record entry {
    version: u64,
    value: list<u8>,
  }

  get: func(key: string) -> result<option<entry>, host-error>;
  put: func(key: string, value: list<u8>, expected: option<u64>) -> result<u64, host-error>;
  /// Removes the value if it is still at version `expected`.
  remove: func(key: string, expected: u64) -> result<_, host-error>;
}

/// The fields of a secret slot granted through `secrets.value`; they are the code's data then.
interface secrets {
  use types.{field, host-error};

  value: func(slot: string) -> result<list<field>, host-error>;
}

/// Native work of the install that runs without the run; each start answers the job's id at once,
/// and a rerun of the same call gets the same id.
interface jobs {
  use types.{field, host-error};
  use objects-read.{object-page};
  use services.{method};

  /// What a job did, read from its row after its record is gone too. `kind` is copy, download,
  /// upload or task; `path` is the bucket path it wrote or read; `state` is queued, running,
  /// succeeded, failed, error, cancelled or unknown.
  record status {
    id: string,
    kind: string,
    path: string,
    state: string,
    message: option<string>,
    bytes: option<u64>,
    version: option<string>,
    reply-status: option<u16>,
    reply-headers: list<field>,
    reply-body: option<list<u8>>,
    exit-code: option<s32>,
    report: option<string>,
  }

  /// Copies an object, pinned to `version` when given, to `target`; needs read on the source and
  /// write on the target.
  copy: func(source: string, version: option<string>, target: string) -> result<string, host-error>;

  /// A download through a service: the service's whole answer becomes a new version of `target`.
  record download-request {
    service: string,
    path: string,
    query: list<field>,
    headers: list<field>,
    target: string,
    /// Bytes the answer may have at most.
    size-limit: option<u64>,
    /// Expected digests by algorithm (`md5`, `sha1`, `sha256`, `crc32`, `crc32c`), hex encoded.
    checksums: list<field>,
  }

  /// Starts a download and answers its job id; it needs write on the target.
  download: func(request: download-request) -> result<string, host-error>;

  /// An upload through a service: one object version as the whole body, or as the file part
  /// `file-field` of a form beside the text `fields`.
  record upload-request {
    service: string,
    method: method,
    path: string,
    query: list<field>,
    headers: list<field>,
    source: string,
    version: option<string>,
    file-field: option<string>,
    fields: list<field>,
  }

  /// Starts an upload with PUT or POST and answers its job id; it needs read on the source.
  upload: func(request: upload-request) -> result<string, host-error>;
  /// Any job of the install.
  get: func(id: string) -> result<status, host-error>;
  /// One page of the objects a task wrote.
  outputs: func(id: string, cursor: option<string>) -> result<object-page, host-error>;
  /// Asks a job of the install to stop; a job that already ended stays as it ended.
  cancel: func(id: string) -> result<_, host-error>;
}

interface log {
  enum level {
    debug,
    info,
    warn,
    error,
  }

  log: func(level: level, message: string);
}

/// One plugin: the code runs the function it registered for the invocation's trigger.
world plugin {
  use types.{invocation, failure};

  import metadata-read;
  import metadata-write;
  import metadata-create;
  import objects-read;
  import services;
  import state;
  import secrets;
  import jobs;
  import log;

  export handle: func(invocation: invocation) -> result<option<string>, failure>;
  /// The triggers the code registered functions for; the build checks them against the manifest.
  export triggers: func() -> list<string>;
}
